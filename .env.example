# Copy to .env and fill with the target deployment values.
# Never commit a real .env file.

# Default target is Hyperliquid EVM mainnet.
RPC_URL=https://rpc.hyperliquid.xyz/evm
CHAIN_ID=999

# Deployment wallet. DEPLOYER_ADDRESS must match DEPLOYER_PRIVATE_KEY.
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# Constructor parameters.
STAKE_TOKEN=
ADMIN=
OPERATOR=
FEE_RECIPIENT=
BTC_PERP_INDEX=0
BTC_SZ_DECIMALS=5

# Existing deployment used by the operator runner.
MARKET_ADDRESS=

# Optional post-deploy role maintenance. ADMIN_PRIVATE_KEY is only needed for set-operator.
ADMIN_PRIVATE_KEY=
OPERATOR_ADDRESS=
OPERATOR_PRIVATE_KEY=
CLEANUP_BATCH_SIZE=50
OPERATOR_TICK_SECONDS=15
OPERATOR_GAS_PRICE=1gwei
# Optional EIP-1559 priority fee override. Leave empty unless the RPC/network requires it.
OPERATOR_PRIORITY_GAS_PRICE=

# Optional forge script flags.
ETHERSCAN_API_KEY=
