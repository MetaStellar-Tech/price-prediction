# Copy to .market-maker.env, or run:
#   ./integration/hyperliquid-live-harness/market-maker.sh init-wallets
#
# Never commit the real .market-maker.env file.

RPC_URL=https://rpc.hyperliquid.xyz/evm
CHAIN_ID=999
MARKET_ADDRESS=0x406661e7AeF968441d53bc9557be3a8FAa92A67B
STAKE_TOKEN=0xb88339CB7199b77E23DB6E890353E22632Ba630f

# Generated by init-wallets.
COLLECTOR_ADDRESS=
COLLECTOR_PRIVATE_KEY=

MAKER_1_ADDRESS=
MAKER_1_PRIVATE_KEY=
MAKER_2_ADDRESS=
MAKER_2_PRIVATE_KEY=
MAKER_3_ADDRESS=
MAKER_3_PRIVATE_KEY=
MAKER_4_ADDRESS=
MAKER_4_PRIVATE_KEY=
MAKER_5_ADDRESS=
MAKER_5_PRIVATE_KEY=
MAKER_6_ADDRESS=
MAKER_6_PRIVATE_KEY=

# Amounts are raw units: USDC defaults to 6 decimals; HYPE native balance is wei.
USDC_DECIMALS=6
MAKER_TARGET_USDC=10000000
MAKER_LOW_WATER_USDC=8000000
MAKER_HIGH_WATER_USDC=15000000
MAKER_TARGET_HYPE_WEI=20000000000000000

# Per-round market-making budgets.
MAKER_MAX_ROUND_USDC=6000000
TOTAL_MAX_ROUND_USDC=24000000
MIN_BET_USDC=1000000
NORMAL_MAX_BET_USDC=3000000
SEVERE_MAX_BET_USDC=10000000
ROUND_POOL_TARGET_BPS=6000
MAKER_EXPOSURE_MIN_BPS=4000
MAKER_EXPOSURE_MAX_BPS=6000
SLIPPAGE_BPS=500

# Loop behavior.
POLL_SECONDS=12
MIN_MAKER_DELAY_SECONDS=2
MAX_MAKER_DELAY_SECONDS=12
CLEANUP_BATCH_SIZE=50
EVENT_FROM_BLOCK=33813039
EVENT_TO_BLOCK=latest

# Hyperliquid RPC can transiently fail receipt polling with invalid block-height errors. Async sends
# publish the transaction hash and let later status/review calls observe the chain result.
CAST_SEND_ASYNC=1
GAS_PRICE_WEI=3100000000
MARKET_GAS_LIMIT=500000
TOKEN_GAS_LIMIT=80000
HYPE_TRANSFER_GAS_LIMIT=21000
